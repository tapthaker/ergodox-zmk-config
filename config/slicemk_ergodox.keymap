#define LAYER_MAIN 0
#define LAYER_NAV 1
#define LAYER_BLUETOOTH 2
#define LAYER_MOUSE 3

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            bindings = <
                &sys_off
                &kp GRAVE               &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4    &kp NUMBER_5 &none         &none                 &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp NUMBER_0  &kp LEFT_BRACKET
                &kp TAB                 &kp Q        &kp W        &kp E        &kp R           &kp T        &none         &kp LEFT_PARENTHESIS  &kp Y        &kp U        &kp I        &kp O        &kp P         &kp RIGHT_BRACKET
                &mt LEFT_CONTROL ESCAPE &kp A        &kp S        &kp D        &kp F           &kp G                                            &kp H        &kp J        &kp K        &kp L        &kp SEMICOLON &kp SINGLE_QUOTE
                &kp LEFT_SHIFT          &kp Z        &kp X        &kp C        &kp V           &kp B        &mo LAYER_NAV &kp RIGHT_PARENTHESIS &kp N        &kp M        &kp COMMA    &kp PERIOD   &kp SLASH     &kp MINUS
                &kp LEFT_CONTROL        &kp LEFT_GUI &kp LEFT_ALT &none        &none                                                                         &none        &kp PLUS     &kp PIPE     &kp BACKSLASH &kp EQUAL
                                                                                                   &none        &none         &mo LAYER_BLUETOOTH   &m_esc_colon
                                                                       &mo LAYER_MOUSE &none        &none         &none                 &kp RETURN   &kp SPACE
                                                                                                            &none         &kp BACKSPACE
            >;
        };

        layer_1 {
            bindings = <
                &sys_off
                &none &none &none &none &none &none &none &none &none          &none          &none        &none           &none &kp C_VOLUME_UP
                &none &none &none &none &none &none &none &none &kp HOME       &none          &none        &kp END         &none &kp C_VOLUME_DOWN
                &none &none &none &none &none &none             &kp LEFT_ARROW &kp DOWN_ARROW &kp UP_ARROW &kp RIGHT_ARROW &none &kp LG(PLUS)
                &none &none &none &none &none &none &none &none &none          &none          &none        &none           &none &kp LG(MINUS)
                &none &none &none &none &none                                  &none          &none        &none           &none &none
                                               &none &none &none &none
                                     &none &none &none &none &none          &none
                                                 &none &none
            >;
        };

        layer_2 {
            bindings = <
                &sys_off
                &out OUT_BLE &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 3 &bt BT_SEL 4 &none &none &none      &none &none &none &none &none &none
                &out OUT_USB &none        &none        &none        &none        &none &none &none      &none &none &none &none &none &none
                &none        &none        &none        &none        &none        &none                  &none &none &none &none &none &none
                &none        &none        &none        &none        &none        &none &none &none      &none &none &none &none &none &none
                &none        &none        &none        &none        &none                                     &none &none &none &none &none
                                                                                  &none &none &none      &none
                                                                     &none        &none &none &none      &none &none
                                                                                        &none &bt BT_CLR
            >;
        };

        layer_3 {
            bindings = <
                &sys_off
                &none &none &none &none &none &none &none &none &none          &none          &none        &none           &none &msc SCRL_UP
                &none &none &none &none &none &none &none &none &none          &none          &none        &none           &none &msc SCRL_DOWN
                &none &none &none &none &none &none             &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none &none
                &none &none &none &none &none &none &none &none &none          &none          &none        &none           &none &none
                &none &none &none &none &none                                  &none          &none        &none           &none &none
                                               &none &none &none &none
                                     &none &none &none &none &mkp LCLK      &mkp RCLK
                                                 &none &none
            >;
        };
    };

    ZMK_MACRO(m_esc_colon,
        wait-ms = <10>;
        tap-ms = <10>;
        bindings = <
            &kp ESC
            &kp COLON
        >;
    );
};

